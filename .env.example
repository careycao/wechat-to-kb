# wechat-to-kb 环境变量配置
# 复制本文件为 .env，按需填写（.env 已在 .gitignore 中排除）
#
#   cp .env.example .env

# 知识库根目录（默认：~/knowledge_base）
# KB_ROOT=/path/to/your/knowledge_base

# 浏览器模式：1 = 无头模式，适合定时任务；默认有界面（方便首次登录）
# KB_HEADLESS=1

# 路由模式：1 = 置信度低时自动选得分最高的库，不询问
# KB_NON_INTERACTIVE=1

# 视频采集 Cookie 路径（默认读取 video_collector/cookies.txt）
# VIDEO_COLLECTOR_COOKIES=/path/to/cookies.txt
